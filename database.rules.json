{
  "rules": {
    "swearjar": {
      ".read": "auth != null",
      ".write": "auth != null",

      "gameState": {
        ".read": "auth != null",
        ".write": "auth != null",
        "kids": {
          "$kidName": {
            ".validate": "newData.hasChildren(['deducted', 'swears'])",
            "deducted": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "swears":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "penalty":  { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        },
        "history": {
          "$idx": {
            ".validate": "newData.hasChild('ts')",
            "amount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" }
          }
        },
        "currentMonth": { ".validate": "newData.isString() && newData.val().length == 7" },
        "budgets": {
          "$monthKey": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }
        }
      },

      "jarSettings": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$idx": {
          ".validate": "newData.hasChildren(['name', 'color'])",
          "name":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
          "color": { ".validate": "newData.isString() && newData.val().length <= 10" }
        }
      },

      "appUsers": {
        ".read": "auth != null",
        ".write": "auth != null"
      },

      "adminPin": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isString() && newData.val().length == 64"
      },

      "adminSession": {
        ".read": "auth != null",
        ".write": "auth != null"
      },

      "potTheme": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isString() && newData.val().length <= 20"
      },

      "notifUsers": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
