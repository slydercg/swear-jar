{
  "name": "swear-jar",
  "version": "2.0.0",
  "description": "Swear Jar - Track swear jar fines for the family",
  "private": true,
  "scripts": {
    "lint": "eslint js/ alexa-lambda/",
    "lint:fix": "eslint js/ alexa-lambda/ --fix",
    "format": "prettier --write 'js/**/*.js' 'css/**/*.css' 'alexa-lambda/**/*.js'",
    "format:check": "prettier --check 'js/**/*.js' 'css/**/*.css' 'alexa-lambda/**/*.js'",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  }
}
